[Unit]
Description=Elasticsearch for Argilla
After=docker.service
Requires=docker.service
# Unit-Version: ${unit_version}

[Service]
Type=simple
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
EnvironmentFile=-/etc/argilla/release.env
ExecStartPre=-/usr/bin/docker rm -f argilla-elastisearch
ExecStartPre=/usr/bin/docker pull elasticsearch:8.17.0
ExecStart=/usr/bin/docker run \
  --rm \
  --network host \
  --name argilla-elastisearch \
  --ulimit memlock=671088640:671088640 \
  --env-file /etc/argilla/elasticsearch.env \
  elasticsearch:8.17.0

[Install]
WantedBy=multi-user.target
