[Unit]
Description=Argilla data labeling container
After=argilla-elastisearch.service argilla-redis.service docker.service
Requires=argilla-elastisearch.service argilla-redis.service docker.service
# Unit-Version: ${unit_version}

# Type=exec (not simple): the unit counts as started only once the ExecStart
# binary has been exec'd, i.e. after the ExecStartPre image pull finishes and
# `docker run` is actually executing. Units ordered After=argilla-server.service
# (notably argilla-reindex) then no longer race the pull / container creation.
[Service]
Type=exec
RemainAfterExit=yes
Restart=on-failure
RestartSec=5
TimeoutStartSec=600
EnvironmentFile=-/etc/argilla/release.env
ExecStartPre=-/usr/bin/docker rm -f argilla-server
ExecStartPre=/bin/sh -c "docker image ls ${IMAGE_REPOSITORY} --format '{{.Repository}}:{{.Tag}}' | grep -v ':${IMAGE_TAG}$' | grep -v ':<none>$' | xargs -r docker image rm"
ExecStartPre=/usr/bin/docker pull ${IMAGE_REPOSITORY}:${IMAGE_TAG}
ExecStart=/usr/bin/docker run \
  --rm \
  --network host \
  --name argilla-server \
  --env-file /etc/argilla.env \
  -v /etc/argilla/oauth.yml:/etc/argilla/oauth.yml:ro \
  ${IMAGE_REPOSITORY}:${IMAGE_TAG}

[Install]
WantedBy=multi-user.target
